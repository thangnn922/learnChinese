# Mẫu biến môi trường. Sao chép thành .env và điền giá trị THẬT.
# .env đã nằm trong .gitignore — KHÔNG bao giờ commit giá trị thật.
# Trên Render, các biến này đặt trong phần Environment của dịch vụ, không đặt trong render.yaml.

# ── Cơ sở dữ liệu ────────────────────────────────────────────────────────────
# Neon: lấy trong Dashboard → Connection string.
#  - Lúc CHẠY dùng chuỗi POOLED (host có "-pooler"), kèm ?sslmode=require
#  - Lúc chạy MIGRATION dùng chuỗi TRỰC TIẾP (không có "-pooler")
# TLS luôn được xác minh bằng kho chứng chỉ của Node — không tắt xác minh chứng chỉ.
DATABASE_URL=postgresql://user:password@ep-vi-du-123456-pooler.ap-southeast-1.aws.neon.tech/yct?sslmode=require

# Số kết nối tối đa trong pool (mặc định 5).
PG_POOL_MAX=5
# Thời gian chờ mở kết nối, ms. Neon ngủ khi rảnh nên lần đầu cần chờ compute thức dậy.
PG_CONNECT_TIMEOUT_MS=15000
# Hạn giờ cho một truy vấn, ms.
PG_STATEMENT_TIMEOUT_MS=20000

# ── Máy chủ ──────────────────────────────────────────────────────────────────
# production: bật cookie Secure, HSTS, nghe trên 0.0.0.0 và bắt buộc phải có PORT.
NODE_ENV=development
# Render tự đặt PORT. Chỉ đặt tay khi chạy trên máy lập trình viên.
PORT=8787
# Bỏ trống để dùng mặc định (0.0.0.0 khi production, 127.0.0.1 khi phát triển).
# HOST=127.0.0.1

# Danh sách IP/CIDR của reverse proxy được tin để đọc X-Forwarded-For.
# Mặc định khi production: "loopback, linklocal, uniquelocal" — đúng cho Render.
# Đừng đặt thành "true": khi đó ai cũng tự khai IP được và né được giới hạn đăng nhập.
# TRUST_PROXY=loopback, linklocal, uniquelocal

# Thư mục build của giao diện. Bỏ trống để tự tìm apps/web/dist.
# WEB_DIST_DIR=

# ── Chỉ dùng cho lệnh seed lần đầu ───────────────────────────────────────────
# Để trống thì seed SINH NGẪU NHIÊN và in ra một lần — không có mật khẩu mặc định trong repo.
# Đặt biến ở đây chỉ khi chạy seed thủ công, và đổi mật khẩu ngay sau lần đăng nhập đầu.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_TEACHER_EMAIL=
SEED_TEACHER_PASSWORD=
SEED_CLASS_CODE=
SEED_STUDENT_CODE=

# ── Chỉ dùng khi sao lưu / khôi phục ─────────────────────────────────────────
# Đích khôi phục, phải KHÁC DATABASE_URL.
# TARGET_DATABASE_URL=
