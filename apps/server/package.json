{
  "name": "@yct/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "npm run -w @yct/shared build && tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "npm run -w @yct/shared build && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/migrate.ts",
    "seed": "npm run -w @yct/shared build && tsx src/seed.ts",
    "test": "npm run -w @yct/shared build && vitest run",
    "migrate:dist": "node dist/migrate.js",
    "seed:dist": "node dist/seed.js",
    "publish-all": "npm run -w @yct/shared build && tsx src/publish-all.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/helmet": "13.1.1",
    "@fastify/static": "10.1.3",
    "@yct/shared": "*",
    "fastify": "5.12.3",
    "pg": "8.23.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
