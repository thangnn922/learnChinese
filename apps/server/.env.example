# Sao chép thành .env và điền giá trị THẬT — tệp .env KHÔNG được commit.
# Không có giá trị thật nào nằm trong repo.

# Chuỗi kết nối Postgres
DATABASE_URL=postgres://user:password@localhost:5432/yct

# Cổng và địa chỉ API. Khi NODE_ENV=production, PORT là bắt buộc (Render tự đặt)
# và HOST mặc định là 0.0.0.0.
PORT=8787
HOST=127.0.0.1

# production bật Secure cookie + HSTS
NODE_ENV=development

# Số kết nối tối đa trong pool
PG_POOL_MAX=5

# Danh sách IP/CIDR của reverse proxy được tin để đọc X-Forwarded-For.
# Mặc định khi production: "loopback, linklocal, uniquelocal" (đúng cho Render).
# TRUST_PROXY=

# Thư mục build của giao diện; bỏ trống để tự tìm apps/web/dist.
# WEB_DIST_DIR=

# ── chỉ dùng cho lệnh seed lần đầu ───────────────────────────────────────
# Nếu để trống, seed sẽ SINH NGẪU NHIÊN và in ra một lần. Đổi ngay sau lần đăng nhập đầu.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_TEACHER_EMAIL=
SEED_TEACHER_PASSWORD=
SEED_CLASS_CODE=
SEED_STUDENT_CODE=
