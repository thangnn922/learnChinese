{
  "name": "yct-learn",
  "private": true,
  "version": "0.1.0",
  "description": "Web hoc tieng Trung YCT/HSK cho hoc sinh Viet Nam (6-12 tuoi)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.11 <23"
  },
  "scripts": {
    "build:content": "npm run -w @yct/shared build:content",
    "typecheck": "npm run -w @yct/shared build && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run -w @yct/shared test",
    "dev:web": "npm run -w @yct/web dev",
    "dev:server": "npm run -w @yct/server dev",
    "build": "npm run -w @yct/shared build && npm run -w @yct/server build && npm run -w @yct/web build",
    "db:migrate": "npm run -w @yct/server migrate",
    "db:seed": "npm run -w @yct/server seed",
    "start": "npm run -w @yct/server start",
    "db:migrate:dist": "npm run -w @yct/server migrate:dist",
    "db:seed:dist": "npm run -w @yct/server seed:dist",
    "db:publish-all": "npm run -w @yct/server publish-all"
  },
  "devDependencies": {
    "lighthouse": "^12.2.1",
    "playwright": "^1.49.1",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  },
  "type": "module"
}
